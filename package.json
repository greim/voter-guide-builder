{
  "name": "voter-guide-builder",
  "version": "0.1.0",
  "private": true,
  "description": "Turns an official ballot-measure booklet PDF into a browsable, printable HTML voter guide.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "guide": "tsx src/cli.ts",
    "fixture": "tsx scripts/fixture-colorado-2026.ts",
    "render-fixture": "tsx scripts/render-fixture.ts",
    "typecheck": "tsc --noEmit",
    "compare-fixture": "tsx scripts/compare-fixture.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "marked": "^18.1.1",
    "marked-smartypants": "^1.1.12",
    "mupdf": "^1.28.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
