{
  "name": "voter-guide-builder",
  "version": "0.1.0",
  "private": true,
  "description": "Turns an official ballot-measure booklet PDF into a browsable, printable HTML voter guide.",
  "type": "module",
  "bin": {
    "voter-guide-builder": "bin/voter-guide-builder.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "guide": "tsx src/cli.ts",
    "fixture": "tsx scripts/fixture-colorado-2026.ts",
    "render-fixture": "tsx scripts/render-fixture.ts",
    "typecheck": "tsc --noEmit",
    "compare-fixture": "tsx scripts/compare-fixture.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@inquirer/prompts": "^8.7.4",
    "commander": "^15.0.0",
    "marked": "^18.1.1",
    "marked-smartypants": "^1.1.12",
    "mupdf": "^1.28.1",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
